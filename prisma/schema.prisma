datasource db { provider = "postgresql" url = env("DATABASE_URL") }
generator client { provider = "prisma-client-js" }
model User { id String @id @default(cuid()) email String @unique passwordHash String? role Role @default(USER) savedJobs SavedJob[] savedTenders SavedTender[] searches SavedSearch[] alerts Alert[] createdAt DateTime @default(now()) }
enum Role { USER EDITOR VERIFIER ADMIN SUPER_ADMIN }
model Organization { id String @id @default(cuid()) name String @unique jobs Job[] tenders Tender[] }
model Source { id String @id @default(cuid()) name String @unique url String? jobs Job[] tenders Tender[] newspaperEditions NewspaperEdition[] }
model Category { id String @id @default(cuid()) name String @unique jobs Job[] }
model Province { id String @id @default(cuid()) name String @unique cities City[] jobs Job[] tenders Tender[] }
model City { id String @id @default(cuid()) name String provinceId String province Province @relation(fields:[provinceId],references:[id]) jobs Job[] tenders Tender[] }
model Job { id String @id @default(cuid()) slug String @unique title String organizationId String organization Organization @relation(fields:[organizationId],references:[id]) categoryId String category Category @relation(fields:[categoryId],references:[id]) jobType String location String? cityId String? city City? @relation(fields:[cityId],references:[id]) provinceId String? province Province? @relation(fields:[provinceId],references:[id]) bps String? education String? experience String? salary String? description String publishedAt DateTime deadline DateTime sourceId String source Source @relation(fields:[sourceId],references:[id]) sourceUrl String officialUrl String? verified Boolean @default(false) active Boolean @default(true) createdAt DateTime @default(now()) updatedAt DateTime @updatedAt savedBy SavedJob[] @@index([deadline]) @@index([provinceId,cityId]) @@index([categoryId,jobType]) @@index([verified,active]) }
model Tender { id String @id @default(cuid()) slug String @unique title String authority String reference String? organizationId String? organization Organization? @relation(fields:[organizationId],references:[id]) provinceId String? province Province? @relation(fields:[provinceId],references:[id]) cityId String? city City? @relation(fields:[cityId],references:[id]) publishedAt DateTime closingAt DateTime estimatedValue String? description String sourceId String source Source @relation(fields:[sourceId],references:[id]) officialUrl String? verified Boolean @default(false) active Boolean @default(true) savedBy SavedTender[] @@index([closingAt]) @@index([provinceId,cityId]) @@index([verified,active]) }
model SavedJob { userId String jobId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) job Job @relation(fields:[jobId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) @@id([userId,jobId]) }
model SavedTender { userId String tenderId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) tender Tender @relation(fields:[tenderId],references:[id],onDelete:Cascade) createdAt DateTime @default(now()) @@id([userId,tenderId]) }
model SavedSearch { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) name String query String? province String? category String? jobType String? createdAt DateTime @default(now()) }
model Alert { id String @id @default(cuid()) userId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) kind String key String uniqueKey String @unique lastSentAt DateTime? createdAt DateTime @default(now()) }
model Newspaper { id String @id @default(cuid()) name String @unique publisher String? sourceUrl String? editions NewspaperEdition[] }
model NewspaperEdition { id String @id @default(cuid()) newspaperId String newspaper Newspaper @relation(fields:[newspaperId],references:[id],onDelete:Cascade) sourceId String source Source @relation(fields:[sourceId],references:[id]) editionDate DateTime pageCount Int? pageUrls Json? advertisements Advertisement[] @@unique([newspaperId,editionDate]) }
model Advertisement { id String @id @default(cuid()) editionId String edition NewspaperEdition @relation(fields:[editionId],references:[id],onDelete:Cascade) pageNumber Int? reference String? title String? extractedText String? officialUrl String? verified Boolean @default(false) }
model AuditLog { id String @id @default(cuid()) actorUserId String? action String entityType String entityId String? metadata Json? createdAt DateTime @default(now()) }
model LinkCheck { id String @id @default(cuid()) url String status Int? checkedAt DateTime @default(now()) ok Boolean }
